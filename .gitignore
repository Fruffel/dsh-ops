# Machine-local harness artifacts: never committed.
harness/upstream/
harness/builds/
harness/current
harness/current-ref

# Progress records the updaters write (harness/state/update.json + update.log,
# plugins.json + plugins.log): machine-local.
harness/state/

# The plugin manifest and the checkouts it installs. Both are machine-local: the
# tracked template is plugins.conf.example, and bin/dsh-plugins.sh clones every
# entry into plugins/ (disposable, like harness/upstream and harness/builds).
plugins.conf
plugins/

# Per-machine deployment settings, copied from dsh-ops.conf.example.
dsh-ops.conf

# Operator-owned patch layer: appended to the generated cordis.patch.yml by
# bin/dsh-install-assets.sh, for config that names this machine (an endpoint on
# the LAN, a pinned port). Machine-specific by construction, so never committed.
harness/cordis.patch.local.yml

# Created only if someone runs npm/pnpm install here; the scripts need none.
node_modules/

# Local scratch (ssh helper, one-off probes): never committed.
scratch/
