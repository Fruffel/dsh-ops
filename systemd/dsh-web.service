[Unit]
Description=DeepSeek Harness Web UI from source (dsh web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@OPS@@/harness/current
Environment=PATH=%h/.local/share/pnpm/bin:%h/.local/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The bind lives in the profile layer (~/.dsh/profiles/web/cordis.patch.yml,
# host: '0.0.0.0'): the harness then answers on every interface at once, and its
# Web runtime trusts each non-internal IPv4 literal it sampled at boot, so no
# address list has to be kept in step with the network. Drop that row to return
# to the bundle's loopback default.
# --trusted-host names the authorities that are NOT IP literals -- the tailnet
# names a browser may type. The operator-surface plugin reads the resulting
# list back out of the running host (ctx.webRuntime.trustedHosts).
ExecStart=%h/.local/share/pnpm/bin/pnpm dsh web --no-open --port 3080 --trusted-host kamer --trusted-host kamer.tail39c8ca.ts.net --trusted-host 100.93.30.88
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
