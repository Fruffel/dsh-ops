[Unit]
Description=DSH tailnet entry (tailnet :3080 -> 127.0.0.1:3080 raw TCP)
After=dsh-web.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@OPS@@
Environment=PATH=%h/.local/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Raw TCP: Host, Origin, cookies and WebSockets cross untouched, so the
# harness sees the authority the browser used and its fence decides on it.
ExecStart=%h/.local/node/bin/node @@OPS@@/proxy/tailscale-proxy.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
