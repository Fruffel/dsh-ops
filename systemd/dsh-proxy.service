[Unit]
Description=DSH Tailscale forwarder (tailnet :3080 -> 127.0.0.1:3080)
After=dsh-web.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/dsh-ops
Environment=PATH=%h/.local/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/node/bin/node %h/Documents/dsh-ops/proxy/tailscale-proxy.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
